      <button id="mode-muni" role="tab">Un municipio</button>
    </div>
  </div>

  <div class="layout">
    <div>
      <div class="panel">
        <div class="hd" id="selhd">Barrio a reemplazar</div>
        <div class="bd" id="selbody"><!-- selectors injected --></div>
      </div>
    </div>
    <div id="mainpane"><!-- target + results injected --></div>
  </div>

  <div class="panel reg" id="regpanel">
    <div class="hd">
      <span>Registro de reemplazos <span id="regcount" class="chip"></span></span>
      <div class="actions">
        <button class="btn" id="clearreg" disabled>Vaciar</button>
        <button class="btn primary" id="csvbtn" disabled>Descargar CSV</button>
      </div>
    </div>
    <div id="regbody"></div>
  </div>
</main>

<div class="toast" id="toast"></div>

