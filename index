<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Reemplazos de muestra · Barrios populares PBA</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
  :root{
    --paper:#f4f6f2; --panel:#ffffff; --ink:#182421; --muted:#63706a;
    --line:#d7ddd4; --line-strong:#c2cabf;
    --accent:#2f7d6b; --accent-deep:#1d5749; --accent-tint:#e7f1ec;
    --amber:#a76410; --amber-tint:#f6ecd9;
    --blue:#2b5f86; --blue-tint:#e5eef5;
    --danger:#a23b32;
    --radius:7px;
    --mono:"SFMono-Regular",ui-monospace,"Cascadia Code",Menlo,Consolas,monospace;
    --sans:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  }
  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);
       font-size:15px;line-height:1.5;font-variant-numeric:tabular-nums}
  h1,h2,h3{margin:0;font-weight:600;letter-spacing:-.01em}
  button{font-family:inherit;font-size:inherit;cursor:pointer}
  select,input{font-family:inherit;font-size:inherit}

  /* ---- top bar ---- */
  header{position:sticky;top:0;z-index:20;background:var(--ink);color:#eef2ee;
         border-bottom:3px solid var(--accent)}
  .bar{max-width:1180px;margin:0 auto;padding:14px 22px;display:flex;align-items:baseline;
       gap:16px;flex-wrap:wrap}
  .mark{font-size:19px;font-weight:600;letter-spacing:-.02em}
  .mark b{color:#9fd8c7;font-weight:600}
  .sub{color:#a9b6b0;font-size:13px}
  .datainfo{margin-left:auto;display:flex;align-items:center;gap:12px;font-size:12.5px;color:#b6c2bc}
  .datainfo b{color:#eef2ee;font-weight:600}
  .linkish{background:none;border:1px solid #46554f;color:#dfe7e2;border-radius:6px;
           padding:5px 10px;font-size:12.5px}
  .linkish:hover{border-color:var(--accent);color:#fff}

  main{max-width:1180px;margin:0 auto;padding:22px}

  /* ---- mode switch ---- */
  .modewrap{display:flex;align-items:center;gap:14px;margin:2px 0 20px;flex-wrap:wrap}
  .modewrap .q{font-size:15px;color:var(--muted)}
  .seg{display:inline-flex;border:1px solid var(--line-strong);border-radius:999px;
       background:var(--panel);overflow:hidden}
  .seg button{border:0;background:transparent;padding:9px 20px;color:var(--muted);font-weight:500}
  .seg button.on{background:var(--accent);color:#fff}
  .seg button+button{border-left:1px solid var(--line)}

  .layout{display:grid;grid-template-columns:320px 1fr;gap:22px;align-items:start}
  @media(max-width:860px){.layout{grid-template-columns:1fr}}

  .panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius)}
  .panel .hd{padding:13px 16px;border-bottom:1px solid var(--line);font-weight:600;font-size:14px}
  .panel .bd{padding:16px}

  label.fld{display:block;margin-bottom:14px}
  label.fld .lab{display:block;font-size:12.5px;color:var(--muted);margin-bottom:5px}
  select.control, input.control{width:100%;padding:9px 10px;border:1px solid var(--line-strong);
       border-radius:6px;background:#fff;color:var(--ink)}
  select.control:focus,input.control:focus{outline:2px solid var(--accent-tint);border-color:var(--accent)}

  .hint{font-size:12.5px;color:var(--muted);margin:2px 0 0}
  .empty{padding:40px 20px;text-align:center;color:var(--muted);font-size:14px}
  .empty b{display:block;color:var(--ink);font-weight:600;margin-bottom:6px;font-size:15px}

  /* ---- objetivo card ---- */
  .target{border-left:4px solid var(--blue);background:linear-gradient(0deg,#fff,#fff)}
  .target .hd{color:var(--blue);display:flex;justify-content:space-between;align-items:center}
  .facts{display:flex;flex-wrap:wrap;gap:0;margin:0;border-top:1px solid var(--line)}
  .fact{flex:1 1 130px;padding:12px 16px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
  .fact .k{font-size:11.5px;color:var(--muted);margin-bottom:3px}
  .fact .v{font-size:15px;font-weight:600}
  .fact .v.big{font-size:20px}

  /* ---- criteria strip ---- */
  .crit{display:flex;flex-wrap:wrap;gap:10px 20px;align-items:center;padding:14px 16px;
        border-top:1px solid var(--line);background:#fbfcfb}
  .crit .item{display:flex;align-items:center;gap:7px;font-size:13.5px}
  .crit .locked{color:var(--accent-deep);font-weight:600;background:var(--accent-tint);
        border:1px solid #c7e0d6;border-radius:6px;padding:5px 10px}
  .crit .locked svg{vertical-align:-2px}
  .crit select.mini{padding:5px 8px;border:1px solid var(--line-strong);border-radius:6px;background:#fff}
  .switch{display:inline-flex;align-items:center;gap:7px;cursor:pointer;user-select:none}
  .switch input{position:absolute;opacity:0}
  .track{width:34px;height:19px;border-radius:999px;background:var(--line-strong);position:relative;transition:.15s}
  .track:after{content:"";position:absolute;top:2px;left:2px;width:15px;height:15px;border-radius:50%;
        background:#fff;transition:.15s}
  .switch input:checked + .track{background:var(--accent)}
  .switch input:checked + .track:after{transform:translateX(15px)}
  .switch input:focus-visible + .track{outline:2px solid var(--accent-tint);outline-offset:2px}

  /* ---- results ---- */
  .rescount{padding:11px 16px;font-size:13px;color:var(--muted);border-top:1px solid var(--line);
        display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
  .tablewrap{overflow-x:auto}
  table{border-collapse:collapse;width:100%;font-size:13.5px}
  th,td{padding:9px 12px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}
  th{font-size:11.5px;color:var(--muted);font-weight:600;background:#fafbfa;position:sticky;top:0;
     cursor:default}
  td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
  tbody tr:hover{background:#f6f9f7}
  .id{font-family:var(--mono);font-size:12px;color:var(--muted)}
  .badge{display:inline-block;font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;line-height:1.5}
  .b-res{background:var(--amber-tint);color:var(--amber)}
  .b-out{background:var(--accent-tint);color:var(--accent-deep)}
  .b-tit{background:#efe6e5;color:var(--danger)}
  .delta.near{color:var(--accent-deep);font-weight:600}
  .delta.far{color:var(--muted)}
  .pick{border:1px solid var(--accent);color:var(--accent-deep);background:#fff;border-radius:6px;
        padding:5px 12px;font-weight:600;font-size:12.5px}
  .pick:hover{background:var(--accent);color:#fff}
  .pick.done{background:var(--accent);color:#fff;border-color:var(--accent)}

  /* ---- municipio ---- */
  .muni-barrios{margin:0;border-top:1px solid var(--line)}
  .capbar{display:inline-flex;gap:6px;align-items:center;font-size:12.5px}
  .chip{display:inline-block;font-size:11.5px;padding:2px 8px;border-radius:6px;background:#eef2ee;color:#3a4642}
  .chip.a{background:#eaf0f5;color:var(--blue)}
  .chip.v{background:#f2ece4;color:var(--amber)}
  .expandbtn{border:1px solid var(--line-strong);background:#fff;border-radius:6px;padding:5px 11px;font-size:12.5px;color:var(--accent-deep)}
  .expandbtn:hover{border-color:var(--accent)}
  tr.detail td{background:#f7faf8;padding:0}
  tr.detail .inner{padding:6px 12px 12px}

  /* ---- registro ---- */
  .reg{margin-top:24px}
  .reg .hd{display:flex;justify-content:space-between;align-items:center}
  .reg .actions{display:flex;gap:8px}
  .btn{border:1px solid var(--line-strong);background:#fff;border-radius:6px;padding:7px 13px;font-size:13px;color:var(--ink)}
  .btn:hover{border-color:var(--accent);color:var(--accent-deep)}
  .btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
  .btn.primary:hover{background:var(--accent-deep)}
  .btn:disabled{opacity:.45;cursor:not-allowed}
  .arrow{color:var(--muted);padding:0 4px}
  .rm{border:0;background:none;color:var(--danger);font-size:16px;line-height:1;padding:2px 6px;border-radius:5px}
  .rm:hover{background:#f5e7e6}
  .regnote{width:100%;border:1px solid var(--line);border-radius:5px;padding:5px 7px;font-size:12.5px}
  .toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;
    padding:10px 18px;border-radius:8px;font-size:13.5px;opacity:0;pointer-events:none;transition:.2s;z-index:50}
  .toast.show{opacity:1}
  .visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  a.help{color:var(--accent-deep)}
</style>
</head>
<body>
<header>
  <div class="bar">
    <div>
      <div class="mark"><b>◵</b> Reemplazos de muestra</div>
    </div>
    <div class="sub">Barrios populares · Provincia de Buenos Aires · investigación CFI</div>
    <div class="datainfo">
      <span>Datos: <b id="datalabel">Mayo 2026</b> · <span id="counts"></span></span>
      <button class="linkish" id="loadbtn">Cargar planilla actualizada…</button>
      <input type="file" id="fileinput" accept=".xlsx,.xls" class="visually-hidden">
    </div>
  </div>
</header>

<main>
  <div class="modewrap">
    <span class="q">¿Qué necesitás reemplazar?</span>
    <div class="seg" role="tablist">
