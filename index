let byId = new Map();                // id -> muestra record (rol/status)
let registro = [];                   // decisions
const state = {
  b_muni:'', b_barrio:'',            // barrio-flow selection
  m_muni:'',                         // municipio-flow selection
  sameType:true, hardFam:false, famTol:40,
  muniFilter:'any', sort:'reserva',
  expanded:new Set()                 // expanded candidate municipios
};

/* ================= HELPERS ================= */
const $ = s=>document.querySelector(s);
const el = (t,c,h)=>{const e=document.createElement(t); if(c)e.className=c; if(h!=null)e.innerHTML=h; return e;};
const esc = s => (s==null?'':String(s)).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const fam = n => (n==null?'—':n.toLocaleString('es-AR'));
const uniqSorted = arr => [...new Set(arr)].sort((a,b)=>a.localeCompare(b,'es'));

function rebuildIndex(){
  byId = new Map();
  MUESTRA.forEach(m=>byId.set(m.id, m));
  $('#counts').textContent = MUESTRA.length + ' barrios en muestra · ' + LISTADO.length + ' en el listado provincial';
}
function statusOf(id){                // reserva | titular | out
  const m = byId.get(id);
  if(!m) return 'out';
  return m.rol==='reserva' ? 'reserva' : 'titular';
}
function badge(st){
  if(st==='reserva') return '<span class="badge b-res">reserva</span>';
  if(st==='titular') return '<span class="badge b-tit">titular · en campo</span>';
  return '<span class="badge b-out">fuera de muestra</span>';
}
function toast(msg){const t=$('#toast');t.textContent=msg;t.classList.add('show');clearTimeout(t._t);t._t=setTimeout(()=>t.classList.remove('show'),1900);}

/* municipios present in the sample */
function muestraMunis(){ return uniqSorted(MUESTRA.map(m=>m.dep)); }
/* estrato(s) of a municipio, from the sample */
function muniEstratos(dep){ return uniqSorted(MUESTRA.filter(m=>m.dep===dep).map(m=>m.e)); }

/* candidate barrios from the provincial list for a given target profile */
function candidates(estrato, tipo, targetFam, targetId, opts){
  opts = opts||{};
  let rows = LISTADO.filter(b=>b.e===estrato && b.id!==targetId);
  if(state.sameType) rows = rows.filter(b=>b.t===tipo);
  else rows = rows.filter(b=>b.t==='Villa'||b.t==='Asentamiento');
  rows = rows.map(b=>{
    const st = statusOf(b.id);
    const d = (targetFam!=null && b.f!=null) ? Math.abs(b.f-targetFam) : null;
    return Object.assign({}, b, {st, d});
  });
  // titular barrios are already being surveyed → hidden unless asked
  if(!opts.showTitular) rows = rows.filter(b=>b.st!=='titular');
  // municipio scope (barrio flow only)
  if(opts.muniFilter==='same' && opts.targetMuni) rows = rows.filter(b=>b.dep===opts.targetMuni);
  if(opts.muniFilter==='diff' && opts.targetMuni) rows = rows.filter(b=>b.dep!==opts.targetMuni);
  if(opts.onlyMuni) rows = rows.filter(b=>b.dep===opts.onlyMuni);
  // optional hard family tolerance (±%)
  if(state.hardFam && targetFam!=null){
    const tol = targetFam * (state.famTol/100);
    rows = rows.filter(b=>b.f!=null && Math.abs(b.f-targetFam)<=tol);
  }
  sortRows(rows, opts.sort||state.sort);
  return rows;
}
function sortRows(rows, how){
  const rank = st => st==='reserva'?0 : st==='out'?1 : 2;
  const byD = (a,b)=>{ if(a.d==null)return 1; if(b.d==null)return -1; return a.d-b.d; };
  if(how==='reserva') rows.sort((a,b)=> rank(a.st)-rank(b.st) || byD(a,b));
  else if(how==='near') rows.sort(byD);
  else if(how==='fam-asc') rows.sort((a,b)=>(a.f??1e9)-(b.f??1e9));
  else if(how==='fam-desc') rows.sort((a,b)=>(b.f??-1)-(a.f??-1));
  else if(how==='az') rows.sort((a,b)=>a.b.localeCompare(b.b,'es'));
}

/* ================= RENDER: selectors ================= */
function renderSelectors(){
  const box = $('#selbody');
  if(mode==='barrio'){
    $('#selhd').textContent='Barrio a reemplazar';
    const munis = muestraMunis();
    const muniOpts = ['<option value="">— Elegí un municipio —</option>']
      .concat(munis.map(d=>`<option ${d===state.b_muni?'selected':''} value="${esc(d)}">${esc(d)}</option>`)).join('');
    let barrioSel='';
    if(state.b_muni){
      const bs = MUESTRA.filter(m=>m.dep===state.b_muni)
        .sort((a,b)=> (a.rol===b.rol?0:a.rol==='titular'?-1:1) || a.b.localeCompare(b.b,'es'));
      const opts=['<option value="">— Elegí un barrio —</option>']
        .concat(bs.map(m=>`<option ${String(m.id)===state.b_barrio?'selected':''} value="${m.id}">${esc(m.b)} · ${m.rol} · ${m.t.slice(0,4)}. · ${fam(m.f)} fam.</option>`)).join('');
      barrioSel = `<label class="fld"><span class="lab">Barrio (de la muestra)</span>
        <select class="control" id="sel-barrio">${opts}</select></label>`;
    }
    box.innerHTML =
      `<label class="fld"><span class="lab">Municipio (partido)</span>
        <select class="control" id="sel-bmuni">${muniOpts}</select></label>
       ${barrioSel}
       <p class="hint">Sólo se listan los ${munis.length} municipios y los barrios que forman parte de la muestra.</p>`;
    $('#sel-bmuni').onchange = e=>{state.b_muni=e.target.value; state.b_barrio=''; renderSelectors(); renderMain();};
    const sb=$('#sel-barrio'); if(sb) sb.onchange = e=>{state.b_barrio=e.target.value; renderMain();};
  } else {
    $('#selhd').textContent='Municipio a reemplazar';
    const munis = muestraMunis();
    const opts=['<option value="">— Elegí un municipio —</option>']
      .concat(munis.map(d=>{
        const n=MUESTRA.filter(m=>m.dep===d).length;
        return `<option ${d===state.m_muni?'selected':''} value="${esc(d)}">${esc(d)} · ${n} barrio${n>1?'s':''}</option>`;
      })).join('');
    box.innerHTML =
      `<label class="fld"><span class="lab">Municipio (partido)</span>
        <select class="control" id="sel-mmuni">${opts}</select></label>
       <p class="hint">Reemplazar un municipio busca otros partidos del <b>mismo estrato</b> que puedan aportar barrios equivalentes.</p>`;
    $('#sel-mmuni').onchange = e=>{state.m_muni=e.target.value; state.expanded.clear(); renderMain();};
  }
}

/* ================= RENDER: criteria strip ================= */
function critStrip(estrato){
  const lock = `<span class="locked"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg> Estrato: ${esc(estrato)}</span>`;
  const type = `<label class="switch"><input type="checkbox" id="c-type" ${state.sameType?'checked':''}><span class="track"></span></label><span>Mismo tipo (villa / asentamiento)</span>`;
  const famsw = `<label class="switch"><input type="checkbox" id="c-fam" ${state.hardFam?'checked':''}><span class="track"></span></label>
       <span>Limitar familias a ±<input class="mini" id="c-tol" type="number" min="5" max="200" step="5" value="${state.famTol}" style="width:64px"> %</span>`;
  const sort = `<span>Ordenar por</span><select class="mini" id="c-sort">
       <option value="reserva" ${state.sort==='reserva'?'selected':''}>Reserva primero, luego familias</option>
       <option value="near" ${state.sort==='near'?'selected':''}>Cercanía de familias</option>
       <option value="fam-asc" ${state.sort==='fam-asc'?'selected':''}>Familias (menor→mayor)</option>
       <option value="fam-desc" ${state.sort==='fam-desc'?'selected':''}>Familias (mayor→menor)</option>
       <option value="az" ${state.sort==='az'?'selected':''}>Barrio (A→Z)</option></select>`;
  let muni='';
  if(mode==='barrio'){
    muni = `<span>Municipio del candidato</span><select class="mini" id="c-muni">
       <option value="any" ${state.muniFilter==='any'?'selected':''}>Cualquiera</option>
       <option value="same" ${state.muniFilter==='same'?'selected':''}>Mismo municipio</option>
       <option value="diff" ${state.muniFilter==='diff'?'selected':''}>Distinto municipio</option></select>`;
  }
  return `<div class="crit">
      <div class="item">${lock}</div>
      <div class="item">${type}</div>
      <div class="item">${famsw}</div>
      <div class="item">${sort}</div>
      ${muni?`<div class="item">${muni}</div>`:''}
    </div>`;
}
function wireCrit(){
  const t=$('#c-type'); if(t)t.onchange=e=>{state.sameType=e.target.checked; renderMain();};
  const f=$('#c-fam'); if(f)f.onchange=e=>{state.hardFam=e.target.checked; renderMain();};
  const tol=$('#c-tol'); if(tol)tol.onchange=e=>{state.famTol=Math.max(5,Math.min(200,+e.target.value||40)); renderMain();};
  const s=$('#c-sort'); if(s)s.onchange=e=>{state.sort=e.target.value; renderMain();};
  const m=$('#c-muni'); if(m)m.onchange=e=>{state.muniFilter=e.target.value; renderMain();};
}

/* ================= RENDER: candidate table ================= */
function candTable(rows, ctx){
  if(!rows.length){
    const msg = (ctx&&ctx.emptyMsg) || 'Probá desactivar “mismo tipo”, ampliar la tolerancia de familias, o cambiar el municipio.';
    return `<div class="empty"><b>No hay candidatos con estos criterios.</b>${msg}</div>`;
  }
  const body = rows.map(b=>{
    const near = b.d!=null && ctx.tf!=null && b.d <= ctx.tf*0.25 ? 'near':'far';
    const dtxt = b.d==null?'—':(b.f>=ctx.tf?'+':'−')+fam(b.d);
    const key = ctx.tag+'|'+b.id;
    const done = registro.some(r=>r.repId===b.id && r.origId===ctx.origId);
    return `<tr>
      <td>${badge(b.st)}</td>
      <td><b>${esc(b.b)}</b> <span class="id">#${b.id}</span></td>
      <td>${esc(b.dep)}</td>
      <td>${esc(b.loc)}</td>
      <td>${esc(b.t)}</td>
      <td class="num">${fam(b.f)}</td>
      <td class="num delta ${near}">${dtxt}</td>
      <td><button class="pick ${done?'done':''}" data-rep="${b.id}">${done?'✓ elegido':'Elegir'}</button></td>
    </tr>`;
  }).join('');
  const tbl = `<div class="tablewrap"><table>
    <thead><tr>
      <th>Estado</th><th>Barrio</th><th>Municipio</th><th>Localidad</th>
      <th>Tipo</th><th class="num">Familias</th><th class="num">Δ vs objetivo</th><th></th>
    </tr></thead><tbody>${body}</tbody></table></div>`;
  return tbl;
}
function wirePicks(scope, ctx){
  scope.querySelectorAll('.pick[data-rep]').forEach(btn=>{
    btn.onclick=()=>{ addRegistro(ctx, +btn.dataset.rep); };
  });
}

/* ================= RENDER: main pane ================= */
function renderMain(){
  const pane = $('#mainpane');
  if(mode==='barrio') renderBarrio(pane);
  else renderMuni(pane);
}

function renderBarrio(pane){
  if(!state.b_barrio){
    pane.innerHTML = `<div class="panel"><div class="empty">
      <b>Elegí el barrio que necesitás reemplazar</b>
      Se muestran sus datos y una lista de barrios equivalentes del listado provincial
      (mismo estrato y —si lo dejás activado— mismo tipo).</div></div>`;
    return;
  }
  const t = MUESTRA.find(m=>String(m.id)===state.b_barrio);
  if(!t){pane.innerHTML='';return;}
  const rows = candidates(t.e, t.t, t.f, t.id, {
    muniFilter:state.muniFilter, targetMuni:t.dep, sort:state.sort
  });
  const nRes = rows.filter(r=>r.st==='reserva').length;
  pane.innerHTML =
   `<div class="panel target">
      <div class="hd">Barrio a reemplazar ${badge(statusOf(t.id))}</div>
      <div class="facts">
        <div class="fact"><div class="k">Barrio</div><div class="v">${esc(t.b)} <span class="id">#${t.id}</span></div></div>
        <div class="fact"><div class="k">Municipio · Localidad</div><div class="v">${esc(t.dep)} · ${esc(t.loc)}</div></div>
        <div class="fact"><div class="k">Estrato</div><div class="v">${esc(t.e)}</div></div>
        <div class="fact"><div class="k">Tipo</div><div class="v">${esc(t.t)}</div></div>
        <div class="fact"><div class="k">Familias</div><div class="v big">${fam(t.f)}</div></div>
      </div>
      ${critStrip(t.e)}
      <div class="rescount"><span><b>${rows.length}</b> candidato${rows.length!==1?'s':''} · ${nRes} en reserva</span>
        <span class="hint">Se ocultan los barrios titulares (ya en campo). Regla dura: estrato${state.sameType?' + tipo':''}.</span></div>
      <div id="candbox"></div>
    </div>`;
  const ctx = {tf:t.f, tag:'b', origId:t.id, orig:t, kind:'barrio'};
  $('#candbox').innerHTML = candTable(rows, ctx);
  wireCrit(); wirePicks($('#candbox'), ctx);
}

function renderMuni(pane){
  if(!state.m_muni){
    pane.innerHTML = `<div class="panel"><div class="empty">
      <b>Elegí el municipio que necesitás reemplazar</b>
      Verás sus barrios muestreados y una lista de municipios del mismo estrato que pueden aportar reemplazos.</div></div>`;
    return;
  }
  const dep = state.m_muni;
  const estr = muniEstratos(dep);
  const barrios = MUESTRA.filter(m=>m.dep===dep)
    .sort((a,b)=>(a.rol===b.rol?0:a.rol==='titular'?-1:1)||a.b.localeCompare(b.b,'es'));
  // need profile: titular barrios by tipo
  const needT = barrios.filter(b=>b.rol==='titular');
  const needAsent = needT.filter(b=>b.t==='Asentamiento').length;
  const needVilla = needT.filter(b=>b.t==='Villa').length;

  // candidate municipios: other deptos sharing any estrato, with available (out-of-sample) barrios
  const estrSet = new Set(estr);
  const perMuni = new Map();
  LISTADO.forEach(b=>{
    if(b.dep===dep) return;
    if(!estrSet.has(b.e)) return;
    if(b.t!=='Villa' && b.t!=='Asentamiento') return;
    if(!perMuni.has(b.dep)) perMuni.set(b.dep,{dep:b.dep, estr:new Set(), availA:0, availV:0, inMuestraT:0, inMuestraR:0});
    const o=perMuni.get(b.dep); o.estr.add(b.e);
    const st=statusOf(b.id);
    if(st==='titular') o.inMuestraT++;
    else if(st==='reserva') o.inMuestraR++;
    else { if(b.t==='Asentamiento')o.availA++; else o.availV++; }
  });
  let cand=[...perMuni.values()];
  // score: covers needed tipos & not already heavily sampled
  const covers = o => (needAsent? o.availA>0:true) && (needVilla? o.availV>0:true);
  cand.sort((a,b)=>{
    const ca=covers(a)?0:1, cb=covers(b)?0:1;
    if(ca!==cb) return ca-cb;
    if(a.inMuestraT!==b.inMuestraT) return a.inMuestraT-b.inMuestraT; // prefer partidos aún no en campo
    return (b.availA+b.availV)-(a.availA+a.availV);
  });

  const barriosRows = barrios.map(b=>`<tr>
      <td>${badge(statusOf(b.id))}</td>
      <td><b>${esc(b.b)}</b> <span class="id">#${b.id}</span></td>
      <td>${esc(b.loc)}</td><td>${esc(b.t)}</td><td class="num">${fam(b.f)}</td>
      <td><button class="expandbtn" data-repl="${b.id}">Buscar reemplazo →</button></td>
    </tr>`).join('');

  pane.innerHTML =
   `<div class="panel target">
      <div class="hd" style="color:var(--accent-deep)">Municipio a reemplazar: ${esc(dep)}</div>
      <div class="facts">
        <div class="fact"><div class="k">Estrato${estr.length>1?'s':''}</div><div class="v">${estr.map(esc).join(' + ')}</div></div>
        <div class="fact"><div class="k">Barrios en muestra</div><div class="v big">${barrios.length}</div></div>
        <div class="fact"><div class="k">Titulares por tipo</div><div class="v"><span class="chip a">${needAsent} asent.</span> <span class="chip v">${needVilla} villa</span></div></div>
        <div class="fact"><div class="k">Municipios del mismo estrato</div><div class="v big">${cand.length}</div></div>
      </div>
      <div class="rescount" style="border-top:1px solid var(--line)"><span>Barrios de <b>${esc(dep)}</b> que habría que reemplazar</span></div>
      <div class="tablewrap muni-barrios"><table>
        <thead><tr><th>Estado</th><th>Barrio</th><th>Localidad</th><th>Tipo</th><th class="num">Familias</th><th></th></tr></thead>
        <tbody>${barriosRows}</tbody></table></div>
    </div>

    <div class="panel" style="margin-top:22px">
      <div class="hd">Municipios del mismo estrato para reemplazar</div>
      ${critStrip(estr.join(' + '))}
      <div class="rescount"><span><b>${cand.length}</b> municipios candidatos</span>
        <span class="hint">Ordenados: primero los que cubren los tipos necesarios y todavía no están en campo. <span class="chip a">a</span> = asentamientos / <span class="chip v">v</span> = villas disponibles (fuera de muestra).</span></div>
      <div class="tablewrap"><table>
        <thead><tr><th>Municipio</th><th>Estrato</th><th class="num">Disp. asent.</th><th class="num">Disp. villa</th><th>Ya en muestra</th><th></th></tr></thead>
        <tbody id="munirows"></tbody></table></div>
    </div>`;

  const mr = $('#munirows');
  cand.forEach(o=>{
    const cov = covers(o);
    const tr = el('tr');
    tr.innerHTML =
      `<td><b>${esc(o.dep)}</b>${cov?'':' <span class="hint">(no cubre todos los tipos)</span>'}</td>
       <td>${[...o.estr].map(esc).join(', ')}</td>
       <td class="num">${o.availA}</td>
       <td class="num">${o.availV}</td>
       <td>${o.inMuestraT?`<span class="chip">${o.inMuestraT} titular</span> `:''}${o.inMuestraR?`<span class="chip">${o.inMuestraR} reserva</span>`:''}${(!o.inMuestraT&&!o.inMuestraR)?'<span class="hint">—</span>':''}</td>
       <td><button class="expandbtn" data-muni="${esc(o.dep)}">${state.expanded.has(o.dep)?'Ocultar barrios':'Ver barrios ▾'}</button></td>`;
    mr.appendChild(tr);
    if(state.expanded.has(o.dep)){
      const det = el('tr','detail');
      const td = el('td'); td.colSpan=6;
      const inner = el('div','inner');
      // all available barrios of this municipio in the same estrato (titulars excluded), reserva first then tipo
      let rows = LISTADO.filter(b=>b.dep===o.dep && estrSet.has(b.e) && (b.t==='Villa'||b.t==='Asentamiento'))
        .map(b=>({...b, st:statusOf(b.id), d:null}))
        .filter(b=>b.st!=='titular');
      rows.sort((a,b)=>{const r=s=>s==='reserva'?0:1; return r(a.st)-r(b.st) || a.t.localeCompare(b.t,'es') || a.b.localeCompare(b.b,'es');});
      const ctx={tf:null, tag:'m', origId:'muni:'+dep, orig:{b:'(municipio) '+dep, id:'—', dep:dep, loc:'', e:estr.join(' + '), t:'—', f:null}, kind:'municipio', replMuni:o.dep,
        emptyMsg:'Este partido no tiene barrios disponibles fuera de la muestra en este estrato.'};
      inner.innerHTML = candTable(rows, ctx);
      td.appendChild(inner); det.appendChild(td); mr.appendChild(det);
      wirePicks(inner, ctx);
    }
  });
  mr.querySelectorAll('.expandbtn[data-muni]').forEach(btn=>{
    btn.onclick=()=>{const d=btn.dataset.muni; state.expanded.has(d)?state.expanded.delete(d):state.expanded.add(d); renderMuni(pane);};
  });
  // "buscar reemplazo" per target barrio → switch to barrio flow pre-filled
  pane.querySelectorAll('.expandbtn[data-repl]').forEach(btn=>{
    btn.onclick=()=>{
      const b = MUESTRA.find(m=>m.id===+btn.dataset.repl);
      mode='barrio'; setModeButtons();
      state.b_muni=b.dep; state.b_barrio=String(b.id);
      renderSelectors(); renderMain();
      window.scrollTo({top:0,behavior:'smooth'});
      toast('Buscando reemplazo para '+b.b);
    };
  });
  wireCrit();
}

/* ================= REGISTRO ================= */
function addRegistro(ctx, repId){
  const rep = LISTADO.find(b=>b.id===repId);
  if(!rep) return;
  // toggle off if same pick already there
  const idx = registro.findIndex(r=>r.repId===repId && r.origId===ctx.origId);
  if(idx>=0){ registro.splice(idx,1); renderMain(); renderRegistro(); toast('Reemplazo quitado'); return; }
  registro.push({
    kind:ctx.kind,
    origId:ctx.origId,
    origBarrio:ctx.orig.b, origMuni:ctx.orig.dep, origLoc:ctx.orig.loc,
    origEstrato:ctx.orig.e, origTipo:ctx.orig.t, origFam:ctx.orig.f,
    repId:rep.id, repBarrio:rep.b, repMuni:rep.dep, repLoc:rep.loc,
    repTipo:rep.t, repFam:rep.f, repEstado:statusOf(rep.id),
    nota:''
  });
  renderMain(); renderRegistro();
  toast('Agregado al registro: '+rep.b);
}
function renderRegistro(){
  $('#regcount').textContent = registro.length;
  $('#csvbtn').disabled = registro.length===0;
  $('#clearreg').disabled = registro.length===0;
  const body=$('#regbody');
  if(!registro.length){ body.innerHTML='<div class="empty">Todavía no elegiste ningún reemplazo. Usá el botón <b style="color:var(--accent-deep)">Elegir</b> en la lista de candidatos.</div>'; return; }
  const rows=registro.map((r,i)=>`<tr>
     <td><span class="chip ${r.kind==='municipio'?'v':'a'}">${r.kind}</span></td>
     <td><b>${esc(r.origBarrio)}</b> ${typeof r.origId==='number'?`<span class="id">#${r.origId}</span>`:''}<br><span class="hint">${esc(r.origMuni)}${r.origLoc?' · '+esc(r.origLoc):''}</span></td>
     <td class="num">${fam(r.origFam)}</td>
     <td class="arrow">→</td>
     <td><b>${esc(r.repBarrio)}</b> <span class="id">#${r.repId}</span> ${badge(r.repEstado)}<br><span class="hint">${esc(r.repMuni)} · ${esc(r.repLoc)}</span></td>
     <td class="num">${fam(r.repFam)}</td>
     <td>${esc(r.repTipo)}</td>
     <td><input class="regnote" data-i="${i}" value="${esc(r.nota)}" placeholder="motivo / nota"></td>
     <td><button class="rm" data-rm="${i}" title="Quitar">×</button></td>
   </tr>`).join('');
  body.innerHTML=`<div class="tablewrap"><table>
     <thead><tr><th>Tipo</th><th>Original</th><th class="num">Fam.</th><th></th><th>Reemplazo</th><th class="num">Fam.</th><th>Tipo</th><th>Nota</th><th></th></tr></thead>
     <tbody>${rows}</tbody></table></div>`;
  body.querySelectorAll('.rm').forEach(b=>b.onclick=()=>{registro.splice(+b.dataset.rm,1);renderRegistro();renderMain();});
  body.querySelectorAll('.regnote').forEach(inp=>inp.onchange=()=>{registro[+inp.dataset.i].nota=inp.value;});
}
function downloadCSV(){
  const cols=['tipo_reemplazo','barrio_original','id_original','municipio_original','localidad_original','estrato','tipo_original','familias_original','barrio_reemplazo','id_reemplazo','municipio_reemplazo','localidad_reemplazo','tipo_reemplazo_barrio','familias_reemplazo','estado_reemplazo','delta_familias','nota'];
  const lines=[cols.join(';')];
  registro.forEach(r=>{
    const delta=(r.origFam!=null&&r.repFam!=null)?(r.repFam-r.origFam):'';
    const cell=v=>{v=(v==null?'':String(v)); return /[";\n]/.test(v)?'"'+v.replace(/"/g,'""')+'"':v;};
    lines.push([r.kind,r.origBarrio,r.origId,r.origMuni,r.origLoc,r.origEstrato,r.origTipo,r.origFam,
      r.repBarrio,r.repId,r.repMuni,r.repLoc,r.repTipo,r.repFam,r.repEstado,delta,r.nota].map(cell).join(';'));
  });
  const blob=new Blob(['\ufeff'+lines.join('\r\n')],{type:'text/csv;charset=utf-8'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob);
  a.download='reemplazos_muestra.csv'; a.click(); URL.revokeObjectURL(a.href);
}

/* ================= LOAD UPDATED FILE ================= */
function ingestWorkbook(wb){
  const norm=s=>String(s==null?'':s).trim();
  const numv=x=>{const n=parseFloat(x); return isNaN(n)?null:Math.round(n);};
  const getSheet=name=>{
    const key=wb.SheetNames.find(s=>s.trim().toLowerCase()===name.toLowerCase());
    return key? XLSX.utils.sheet_to_json(wb.Sheets[key],{defval:null}) : null;
  };
  const L=getSheet('Listado provincial de barrios');
  const M=getSheet('Barrios muestra');
  if(!L||!M){ toast('No encontré las hojas esperadas en la planilla'); return false; }
  LISTADO = L.filter(r=>r['ID Renabap']!=null).map(r=>({
    id:numv(r['ID Renabap']), b:norm(r['Barrio']), dep:norm(r['Departamento']), loc:norm(r['Localidad']),
    e:norm(r['Area']), f:numv(r['Familias Aproximadas']), t:norm(r['Clasificación Barrio'])
  }));
  MUESTRA = M.filter(r=>r['ID Renabap']!=null).map(r=>({
    id:numv(r['ID Renabap']), b:norm(r['Barrio']), dep:norm(r['Departamento']), loc:norm(r['Localidad']),
    e:norm(r['estrato']), t:norm(r['tipo']), f:numv(r['familias']), rol:norm(r['rol']), sec:norm(r['Sector'])
  }));
  return true;
}
$('#loadbtn').onclick=()=>$('#fileinput').click();
$('#fileinput').onchange=async e=>{
  const f=e.target.files[0]; if(!f) return;
  try{
    const buf=await f.arrayBuffer();
    const wb=XLSX.read(buf,{type:'array'});
    if(ingestWorkbook(wb)){
      registro=[]; state.b_muni=state.b_barrio=state.m_muni=''; state.expanded.clear();
      rebuildIndex();
      const m=f.name.match(/(\w+)[ _-]?(\d{4})/); $('#datalabel').textContent = f.name.replace(/\.(xlsx|xls)$/i,'');
      renderSelectors(); renderMain(); renderRegistro();
      toast('Planilla actualizada: '+MUESTRA.length+' barrios en muestra');
    }
  }catch(err){ console.error(err); toast('No pude leer el archivo'); }
  e.target.value='';
};

/* ================= MODE ================= */
function setModeButtons(){
  $('#mode-barrio').classList.toggle('on', mode==='barrio');
  $('#mode-muni').classList.toggle('on', mode==='muni');
}
$('#mode-barrio').onclick=()=>{mode='barrio'; setModeButtons(); renderSelectors(); renderMain();};
$('#mode-muni').onclick=()=>{mode='muni'; setModeButtons(); renderSelectors(); renderMain();};

/* ================= INIT ================= */
rebuildIndex();
renderSelectors();
renderMain();
renderRegistro();
</script>
